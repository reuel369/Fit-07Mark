<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fit07Mark Tracker</title>
    <style>
        :root {
            --bg-color: #000;
            --card-bg: #121212;
            --accent-red: #ff3b30;
            --text-main: #ffffff;
            --text-dim: #a0a0a0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        h1 { color: var(--accent-red); margin-bottom: 0; text-transform: uppercase; letter-spacing: 2px; text-align: center; }
        .subtitle { color: var(--text-dim); font-style: italic; margin-bottom: 25px; font-size: 0.9em; text-align: center; }

        .card {
            background-color: var(--card-bg);
            border-left: 4px solid var(--accent-red);
            border-radius: 12px;
            width: 100%;
            max-width: 400px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }

        h2 { color: var(--accent-red); font-size: 1.2em; margin-top: 0; margin-bottom: 15px; }

        .row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #222;
        }

        .row:last-of-type { border-bottom: none; }

        input[type="checkbox"] { width: 22px; height: 22px; accent-color: var(--accent-red); cursor: pointer; }

        input[type="number"] {
            background: #222;
            border: 1px solid #444;
            color: white;
            padding: 8px;
            border-radius: 6px;
            width: 75px;
            text-align: right;
            font-size: 1rem;
        }

        .total-box {
            margin-top: 25px;
            text-align: center;
            font-weight: bold;
            font-size: 1.4em;
            color: var(--accent-red);
            border-top: 2px solid #333;
            padding-top: 20px;
        }
    </style>
</head>
<body>

    <h1>FITNESS TRACKER</h1>
    <div class="subtitle">Daily Cutting & Muscle Retention</div>

    <!-- Today's Checklist Section from 1000182048.png -->
    <div class="card">
        <h2>Today's Checklist</h2>
        <div class="row"><span>Workout Completed</span><input type="checkbox"></div>
        <div class="row"><span>Protein Target Hit</span><input type="checkbox"></div>
        <div class="row"><span>3.7L Water Completed</span><input type="checkbox"></div>
        <div class="row"><span>7+ Hours Sleep</span><input type="checkbox"></div>
    </div>

    <!-- Full Protein Calculator Section from 1000182048.png -->
    <div class="card">
        <h2>Protein Calculator</h2>
        <div class="row"><span>Eggs (Count)</span><input type="number" id="eggs" value="0" oninput="calc()"></div>
        <div class="row"><span>Milk (Glasses)</span><input type="number" id="milk" value="0" oninput="calc()"></div>
        <div class="row"><span>Oats (g)</span><input type="number" id="oats" value="0" oninput="calc()"></div>
        <div class="row"><span>Chicken (g)</span><input type="number" id="chicken" value="0" oninput="calc()"></div>
        <div class="row"><span>Rice (g)</span><input type="number" id="rice" value="0" oninput="calc()"></div>
        <div class="row"><span>Whey Scoops</span><input type="number" id="whey" value="0" oninput="calc()"></div>
        <div class="row"><span>Bananas</span><input type="number" id="bananas" value="0" oninput="calc()"></div>
        <div class="row"><span>Soya Chunks (g)</span><input type="number" id="soya" value="0" oninput="calc()"></div>
        
        <div class="total-box">Total Protein: <span id="total">0.0</span>g</div>
    </div>

    <script>
        function calc() {
            const getVal = (id) => parseFloat(document.getElementById(id).value) || 0;

            // Accurate protein calculations
            const eggs = getVal('eggs') * 6;
            const milk = getVal('milk') * 8;
            const oats = (getVal('oats') / 100) * 13;
            const chicken = (getVal('chicken') / 100) * 31;
            const rice = (getVal('rice') / 100) * 2.7;
            const whey = getVal('whey') * 24;
            const bananas = getVal('bananas') * 1.3;
            const soya = (getVal('soya') / 100) * 52;
            
            const total = (eggs + milk + oats + chicken + rice + whey + bananas + soya).toFixed(1);
            document.getElementById('total').innerText = total;
        }
    </script>
</body>
</html>
